# PIENG Energy Monitor - Configuração de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no Git!

# ===== Aplicação =====
APP_NAME=Energy Meter Master
API_PREFIX=/api
SCHEDULER_TIMEZONE=America/Sao_Paulo

# ===== Banco de Dados =====
# Banco ÚNICO: Postgres nativo 17 (data dir no SSD F:)
# Servico Windows: postgresql-x64-17 | data: F:\storage\postgres\energy_meter\pgdata
# K: = backup/cópia fria. A app fala via TCP localhost:5432 (não abre pasta F:).
DATABASE_URL=postgresql://energy_meter:energy_meter_dev_only@localhost:5432/energy_meter

# Outro PC via Tailscale (servidor = cca-tecnica):
# DATABASE_URL=postgresql://energy_meter:energy_meter_dev_only@100.104.172.12:5432/energy_meter

# Legado — NÃO usar (arquivo arquivado em data/app.db.archived_*):
# DATABASE_URL=sqlite:///./data/app.db

# Credenciais do cluster (mesmo role do DATABASE_URL)
POSTGRES_USER=energy_meter
POSTGRES_PASSWORD=energy_meter_dev_only
POSTGRES_DB=energy_meter
# Politica de acesso: projeto pieng_postgres → REMOTE_ACCESS.md

# Flush SQLite→Postgres: desligado (runtime_settings.json postgres_flush_enabled=false)

# Producao futura (PostgreSQL no Fidelco / mini PC)
# DATABASE_URL=postgresql://pieng_admin:SUA_SENHA_AQUI@IP_FIDELCO:5432/pieng_production

# ===== Tuya IoT API =====
# Obtenha em: https://iot.tuya.com/
# 1. Criar projeto Cloud
# 2. Copiar Access ID e Access Secret
# 3. NUNCA exponha essas credenciais!

TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_REGION=us
# TUYA_PROJECT_CODE=  # opcional, só referência do console iot.tuya.com

# Regiões disponíveis:
# us - Americas (recomendado para Brasil)
# eu - Europa
# cn - China
# in - Índia

# ===== Google APIs (Opcional) =====
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-cloud-key.json

# ===== Firebase / Firestore (Opcional - backup em nuvem das leituras) =====
# 1. Criar projeto em https://console.firebase.google.com/
# 2. Ativar Firestore (modo nativo)
# 3. Configurações do projeto > Contas de serviço > Gerar nova chave privada
# 4. Salvar o JSON baixado (NUNCA commitar!) e apontar o caminho abaixo
FIREBASE_ENABLED=false
# FIREBASE_CREDENTIALS_PATH=./credentials/firebase-service-account.json
FIREBASE_COLLECTION=readings

# ===== OpenAI API (Opcional - para IA/RAG) =====
# OPENAI_API_KEY=sk-...

# ===== Sistema de Forwarding =====
ENABLE_FORWARDING=false
# FORWARDER_URL=http://outro-servidor:9000

# ===== Segurança =====
# JWT_SECRET=generate_random_secret_here
# JWT_REFRESH_SECRET=another_random_secret_here

# ===== Notificações (Opcional) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-app
# SMTP_FROM=noreply@pieng.com

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ===== Monitoramento (Opcional) =====
# SENTRY_DSN=
# PROMETHEUS_PORT=9090
